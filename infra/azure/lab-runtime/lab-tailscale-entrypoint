#!/bin/bash
# Bake this executable and lab-serve.json into the reviewed, digest-pinned image.
# Image contract: bash, /usr/local/bin/containerboot, and /usr/local/bin/lab-app.
# lab-app must stay in the foreground and bind only 127.0.0.1:8080.
set -euo pipefail
: "${TS_AUTHKEY:?Tailscale enrollment is required}"
app_pid=""
tailnet_pid=""
cleanup() {
  trap - EXIT TERM INT
  [ -z "$app_pid" ] || kill -TERM "$app_pid" 2>/dev/null || true
  [ -z "$tailnet_pid" ] || kill -TERM "$tailnet_pid" 2>/dev/null || true
  # Bound shutdown even if the experiment ignores SIGTERM.
  sleep 2
  [ -z "$app_pid" ] || kill -KILL "$app_pid" 2>/dev/null || true
  [ -z "$tailnet_pid" ] || kill -KILL "$tailnet_pid" 2>/dev/null || true
  wait || true
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
# Do not pass the enrollment key in the application's environment.
env -u TS_AUTHKEY /usr/local/bin/lab-app &
app_pid=$!
/usr/local/bin/containerboot &
tailnet_pid=$!
# Failure of either process terminates both. No non-tailnet fallback listener.
wait -n "$app_pid" "$tailnet_pid"
