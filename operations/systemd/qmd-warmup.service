[Unit]
Description=Pre-warm QMD query models into page cache
After=network.target

[Service]
Type=oneshot
Environment=PATH=/root/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_LLAMA_CPP_GPU=false
Environment=XDG_CONFIG_HOME=/root/.openclaw/agents/main/qmd/xdg-config
Environment=XDG_CACHE_HOME=/root/.openclaw/agents/main/qmd/xdg-cache
ExecStart=/usr/local/bin/qmd query "warmup" --json -n 1
TimeoutStartSec=600
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
