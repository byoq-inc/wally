[Unit]
Description=GitHub PR Webhook Receiver
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/github-webhook/server.py
Restart=always
RestartSec=5
EnvironmentFile=/etc/wally-harness/github-webhook.env
Environment=HOME=/root
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/root/.local/bin:/root/.deno/bin

[Install]
WantedBy=multi-user.target
