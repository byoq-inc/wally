#!/usr/bin/env bash
# Model-independent, exact-message-bound proposal reaction handler.
set -euo pipefail
set -a
# shellcheck disable=SC1091
source /root/.config/govfiles-proposals/runtime.env
set +a
cd /opt/govfiles-proposals
exec /opt/govfiles-proposals/venv/bin/python -m proposal_agent.reactions \
  --state-dir /var/lib/govfiles-proposals
