#!/usr/bin/env bash
# Runtime-only authentication launcher for the read-only GovFiles proposal poller.
set -uo pipefail
: "${OP_VAULT_NAME:?OP_VAULT_NAME is required}"
CONFIG=/root/.config/govfiles-proposals/runtime.env
STATE=/var/lib/govfiles-proposals
SOCKET_DIR="${OPENCLAW_TMUX_SOCKET_DIR:-${CLAWDBOT_TMUX_SOCKET_DIR:-${TMPDIR:-/tmp}/openclaw-tmux-sockets}}"

set -a
# shellcheck disable=SC1090
source "$CONFIG"
set +a

if [ -z "${GOG_KEYRING_PASSWORD:-}" ] && [ -d "$SOCKET_DIR" ]; then
  for sock in "$SOCKET_DIR"/*.sock; do
    [ -S "$sock" ] || continue
    tmux -S "$sock" list-sessions >/dev/null 2>&1 || continue
    while IFS= read -r line; do
      case "$line" in
        OP_SERVICE_ACCOUNT=*|OP_SERVICE_ACCOUNT_TOKEN=*|GOG_KEYRING_PASSWORD=*) export "$line" ;;
      esac
    done < <(tmux -S "$sock" show-environment -g 2>/dev/null || true)
    [ -n "${GOG_KEYRING_PASSWORD:-}" ] && [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] && break
  done
fi

if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
  for environ in /proc/[0-9]*/environ; do
    [ -r "$environ" ] || continue
    token="$({ tr '\0' '\n' < "$environ" | awk -F= '$1=="OP_SERVICE_ACCOUNT_TOKEN" {sub(/^[^=]*=/, ""); print; exit}'; } 2>/dev/null)" || true
    if [ -n "$token" ]; then export OP_SERVICE_ACCOUNT_TOKEN="$token"; unset token; break; fi
  done
fi

[ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] || { echo '{"status":"error","reason":"AUTH_UNAVAILABLE"}' >&2; exit 1; }
if [ -z "${GOG_KEYRING_PASSWORD:-}" ]; then
  GOG_KEYRING_PASSWORD="$(op item get GOG_KEYRING --vault "$OP_VAULT_NAME" --format json 2>/dev/null | jq -r '.fields[] | select(.id=="notesPlain" or .label=="notesPlain") | .value')" || exit 1
  export GOG_KEYRING_PASSWORD
fi

granola_key="$(op read "op://${OP_VAULT_NAME}/GRANOLA API KEY/credential" 2>/dev/null)" || exit 1
exec 3<<<"$granola_key"
unset granola_key
cd /opt/govfiles-proposals
exec /opt/govfiles-proposals/venv/bin/python -m proposal_agent.cli "${1:-run}" --state-dir "$STATE"
