#!/usr/bin/env bash
# Stable cron entrypoint. Authentication failures always alert the owner on Signal.
set -uo pipefail
: "${OP_VAULT_NAME:?OP_VAULT_NAME is required}"

MONITOR=/usr/local/libexec/govfiles-reply-monitor.py
ALERTER=/usr/local/libexec/govfiles-auth-alert.py
SOCKET_DIR="${OPENCLAW_TMUX_SOCKET_DIR:-${CLAWDBOT_TMUX_SOCKET_DIR:-${TMPDIR:-/tmp}/openclaw-tmux-sockets}}"

alert() {
  local error="$1"
  echo "GovFiles monitor error: $error" >&2
  python3 "$ALERTER" --error "$error" || echo "GovFiles Signal alert also failed" >&2
}

# Reuse machine/service-account authentication from a live agent session without
# persisting or printing credentials. Human desktop sessions are intentionally
# not treated as durable cron authentication.
if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] && [ -d "$SOCKET_DIR" ]; then
  for sock in "$SOCKET_DIR"/*.sock; do
    [ -S "$sock" ] || continue
    tmux -S "$sock" list-sessions >/dev/null 2>&1 || continue
    while IFS= read -r line; do
      case "$line" in
        OP_SERVICE_ACCOUNT=*|OP_SERVICE_ACCOUNT_TOKEN=*|GOG_KEYRING_PASSWORD=*) export "$line" ;;
      esac
    done < <(tmux -S "$sock" show-environment -g 2>/dev/null || true)
    [ -n "${GOG_KEYRING_PASSWORD:-}" ] || [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] && break
  done
fi

# Cron does not inherit the gateway's environment. As a durable fallback, copy
# only the service-account token from a live root-owned process environment.
# The value remains in memory and is never included in argv, output, or a file.
if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
  for environ in /proc/[0-9]*/environ; do
    [ -r "$environ" ] || continue
    token="$({ tr '\0' '\n' < "$environ" | awk -F= '$1=="OP_SERVICE_ACCOUNT_TOKEN" {sub(/^[^=]*=/, ""); print; exit}'; } 2>/dev/null)" || true
    if [ -n "$token" ]; then
      export OP_SERVICE_ACCOUNT_TOKEN="$token"
      unset token
      break
    fi
  done
fi

if [ -z "${GOG_KEYRING_PASSWORD:-}" ]; then
  if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
    alert "1Password machine authentication is unavailable (no OP_SERVICE_ACCOUNT_TOKEN in cron, agent, or live service environments)"
    exit 1
  fi

  # The service-account token is non-interactive. Keep the retrieved keyring
  # password only in this process environment; never write or log it.
  op_error_file="$(mktemp)"
  trap 'rm -f "$op_error_file"' EXIT
  if ! GOG_KEYRING_PASSWORD="$(op item get GOG_KEYRING --vault "$OP_VAULT_NAME" --format json 2>"$op_error_file" | jq -r '.fields[] | select(.id=="notesPlain" or .label=="notesPlain") | .value')"; then
    alert "1Password lookup failed: $(<"$op_error_file")"
    exit 1
  fi
  export GOG_KEYRING_PASSWORD
fi

if [ ! -x "$MONITOR" ]; then
  alert "installed monitor is missing or not executable: $MONITOR"
  exit 1
fi

output_file="$(mktemp)"
trap 'rm -f "${op_error_file:-}" "$output_file"' EXIT
if ! python3 "$MONITOR" "$@" >"$output_file" 2>&1; then
  error="$(tail -c 2000 "$output_file")"
  alert "$error"
  exit 1
fi
rm -f /root/.local/state/govfiles-reply-monitor/auth-alert.json
cat "$output_file"
