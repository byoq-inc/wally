# Deny by default. Add new export paths explicitly and run validation before commit.
*

!.gitignore
!.env.example
!README.md
!LICENSE

!config/
!config/**
!components/
!components/**
!operations/
!operations/**
!pi/
!pi/**
!scripts/
!scripts/**
!tests/
!tests/**
!.github/
!.github/workflows/
!.github/workflows/validate.yml

# Never admit runtime/private material even beneath allowed trees.
**/.env
**/.env.*
!**/.env.example
**/*secret*
**/*credential*
**/auth.json
**/config.json
!**/config.example.json
**/sessions/
**/memory/
**/logs/
**/state/
**/runtime/
**/media/
**/backups/
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/chrome-profile/
**/*.jsonl
**/*.log
**/*.sqlite*
**/*.db
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.pyc
**/*.pid
**/*.lock
**/*.bak*
**/*.bundle

# Reviewed source-code exceptions (not runtime credentials or memory content).
!pi/extensions/memory/
!pi/extensions/memory/**
