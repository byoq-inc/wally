# Copy values into host-owned, mode-0600 EnvironmentFile files. Never commit them.
GITHUB_WEBHOOK_SECRET=<random-webhook-signing-secret>
OPENCLAW_GATEWAY_TOKEN=<gateway-auth-token>
OP_SERVICE_ACCOUNT_TOKEN=<one-password-service-account-token>
OP_VAULT_NAME=<one-password-vault-name>
PR_ORCH_REPO=<github-owner/repository>
PR_ORCH_WEBHOOK_PORT=9877
PR_ORCH_WEBHOOK_BIND=127.0.0.1
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
SIGNAL_ACCOUNT=<signal-service-e164-number>
SIGNAL_RECIPIENT=<authorized-recipient-e164-number>
PI_MEMORY_REPOSITORY=<github-owner/private-memory-repository>
PI_MEMORY_GIT_EMAIL=<automation-git-email>
BRAVE_API_KEY=<brave-search-api-key>
DATABASE_URL=<read-only-database-connection-string>
AWS_PROFILE=<read-only-aws-profile>
